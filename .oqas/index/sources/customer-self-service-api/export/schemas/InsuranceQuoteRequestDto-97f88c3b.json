      "type": "integer",
      "format": "int64"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "statusHistory": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/RequestStatusChangeDto"
      }
    },
    "customerInfo": {
      "$ref": "#/components/schemas/CustomerInfoDto"
    },
    "insuranceOptions": {
      "$ref": "#/components/schemas/InsuranceOptionsDto"
    },
    "insuranceQuote": {
      "$ref": "#/components/schemas/InsuranceQuoteDto"
    },
